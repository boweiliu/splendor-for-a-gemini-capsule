 resolve_hostname() {
@@ -111,7 +116,8 @@ fi
 # before backgrounding completes.
 STATUS_PID=""
 AGATE_PID=""
-trap 'kill -TERM ${AGATE_PID:-} ${STATUS_PID:-} 2>/dev/null; wait' TERM INT
+FRONT_PID=""
+trap 'kill -TERM ${AGATE_PID:-} ${STATUS_PID:-} ${FRONT_PID:-} 2>/dev/null; wait' TERM INT
 
 log "starting HTTP sidecar on :$STATUS_PORT"
 # Launch via uvicorn so we get HTTP/1.1 keep-alive, proper graceful
@@ -127,31 +133,40 @@ python3 -m uvicorn server:app \
 STATUS_PID=$!
 cd - >/dev/null
 
-log "starting agate for $HOSTNAME on :1965"
-# --skip-port-check: OpenHost may publish us on a host port other
-# than 1965 in the future (e.g. if an operator remaps the
-# [[ports]] entry). The request URL Gemini clients send to us
-# through DNS + OpenHost's publish will still carry the public
-# port. With the current cloudinabottle.toml this is harmless; leaving
-# the flag on keeps things robust if the mapping ever changes.
+log "starting agate for $HOSTNAME on 127.0.0.1:$AGATE_PORT (behind the front door)"
+# --skip-port-check: the request URL clients send carries the public
+# port (1965) while agate listens on a loopback port behind the front
+# door, so agate must not compare the two.
+# --log-ip: every request reaches agate from the front door, so these
+# log lines show 127.0.0.1; the front door logs /splendor requests.
 /usr/local/bin/agate \
     --hostname "$HOSTNAME" \
     --content "$CONTENT_DIR" \
     --certs "$CERTS_DIR" \
-    --addr '0.0.0.0:1965' \
+    --addr "127.0.0.1:$AGATE_PORT" \
     --skip-port-check \
     --log-ip &
 AGATE_PID=$!
 
+log "starting Gemini front door on :1965"
+# Waits for agate to write its certificate on first boot, then serves
+# the same certificate on the public port.
+CERTS_DIR="$CERTS_DIR" \
+SPLENDOR_DATA_DIR="$DATA_DIR/splendor" \
+AGATE_ADDR="127.0.0.1:$AGATE_PORT" \
+LISTEN_PORT=1965 \
+    node "$SPLENDOR_DIR/server.js" &
+FRONT_PID=$!
+
