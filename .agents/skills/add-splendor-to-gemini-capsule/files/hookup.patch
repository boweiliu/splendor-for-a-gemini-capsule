 # Pin Starlette + Uvicorn versions so the editor's behaviour can't
@@ -58,6 +60,9 @@ RUN set -eux; \
 COPY start.sh /usr/local/bin/start.sh
 COPY sidecar/ /usr/local/share/openhost-gemini/sidecar/
